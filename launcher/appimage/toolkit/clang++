#!/bin/sh
# Country-Box build kit: clang with the kit's own sysroot (Ubuntu 22.04: glibc 2.35, libstdc++ 12) and headers.
# K is the kit as reached through the path that called us: during Prepare a fixed symlink, so the paths ninja keeps
# in its dependency log stay the same from one AppImage mount (/tmp/.mount_XXXX) to the next. Never resolved (no -P).
d=${0%/*}; [ "$d" = "$0" ] && d=.; K=$(cd "$d/.." && pwd)
case ${0##*/} in clang++) drv=clang++ ;; *) drv=clang ;; esac
# rpath $ORIGIN: the game finds the libSDL3.so.0 that Prepare leaves next to it
exec "$K/llvm/bin/$drv" --sysroot="$K/sysroot" -resource-dir="$K/llvm/lib/clang/current" -Qunused-arguments \
    '-Wl,-rpath,$ORIGIN' "$@"
